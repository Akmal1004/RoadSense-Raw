{
  "name": "roadsense-selenium-nodejs",
  "version": "2.4.0",
  "description": "Enterprise Selenium Node.js Automation Testing Framework for RoadSense Web Application",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.js 'tests/**/*.spec.js'",
    "test:parallel": "mocha --parallel 'tests/**/*.spec.js'",
    "test:smoke": "mocha 'tests/**/*.spec.js' --grep '@smoke'",
    "test:regression": "mocha 'tests/**/*.spec.js' --grep '@regression'",
    "report:mochawesome": "mochawesome-merge reports/mochawesome/*.json > reports/output.json && mochawesome-report-generator reports/output.json -o reports",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "log4js": "^6.9.1",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "selenium-webdriver": "^4.18.1"
  },
  "devDependencies": {
    "allure-mocha": "^2.13.0"
  }
}
